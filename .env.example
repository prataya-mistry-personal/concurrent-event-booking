# Postgres. If your password contains special characters they must be
# URL-encoded (e.g. '#' becomes %23).
# connection_limit is raised so concurrent load tests are not serialized by the
# Prisma pool (the default of num_cpus*2+1 masks real contention).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/event_booking?schema=public&connection_limit=25"
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/event_booking_test?schema=public&connection_limit=25"

REDIS_URL="redis://localhost:6379"
# Tests use a separate Redis logical database so they never clobber dev keys.
TEST_REDIS_URL="redis://localhost:6379/1"

PORT=3000

# Seconds a seat hold remains valid. Lower this for demos.
HOLD_DURATION_SECONDS=300
# How often the expired-hold reaper sweeps. Lower this for demos.
REAPER_INTERVAL_MS=60000
